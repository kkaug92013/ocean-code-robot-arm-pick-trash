/* Function definitions ------------------------------------------------------- */
bool ei_camera_init_safe(void);
void ei_camera_deinit(void);
bool ei_camera_capture(uint32_t img_width, uint32_t img_height, uint8_t *out_buf);
void checkESP32System();

/**
* @brief      Arduino setup function
*/
void setup()
{
    Serial.begin(115200);
    delay(2000);
    
    Serial.println("\n=== ESP32-CAM DMA OVERFLOW FIX ===");
    Serial.println("Optimized for regular ESP32-CAM modules");
    
    // Check system health
    checkESP32System();
    
    // Initialize camera with DMA overflow protection
    Serial.println("🔧 Initializing camera with DMA overflow protection...");
    if (!ei_camera_init_safe()) {
        Serial.println("\n❌ CAMERA INITIALIZATION FAILED!");
        Serial.println("\n🔧 TROUBLESHOOTING:");
        Serial.println("1. Check power supply (5V 2A minimum)");
        Serial.println("2. Verify camera ribbon cable connection");
        Serial.println("3. Try pressing RESET button");
        Serial.println("4. Check if camera module is compatible");
        
        while(1) {
            delay(10000);
            Serial.println("💀 System halted - camera initialization failed");
        }
    }
    
    Serial.println("✅ Camera initialized successfully!");
    Serial.println("✅ DMA overflow protection active");
    Serial.println("✅ Setup completed - starting inference");
    delay(2000);
}

/**
* @brief      Check ESP32 system health
*/
void checkESP32System() {
    Serial.printf("🔍 ESP32 System Info:\n");
    Serial.printf("   Chip: %s rev%d\n", ESP.getChipModel(), ESP.getChipRevision());
    Serial.printf("   Cores: %d @ %d MHz\n", ESP.getChipCores(), ESP.getCpuFreqMHz());
    Serial.printf("   Flash: %d MB\n", ESP.getFlashChipSize() / (1024*1024));
    Serial.printf("   Free heap: %d bytes\n", ESP.getFreeHeap());
    Serial.printf("   Min free heap: %d bytes\n", ESP.getMinFreeHeap());
    
    // Check PSRAM availability
    if (psramFound()) {
        Serial.printf("   ✅ PSRAM: %d bytes free\n", ESP.getFreePsram());
    } else {
        Serial.println("   ⚠️  PSRAM: Not available (normal for some ESP32-CAM)");
        Serial.println("   Using regular RAM for camera buffers");
    }
    
    // Memory health warnings
    if (ESP.getFreeHeap() < 100000) {
        Serial.println("   ⚠️  WARNING: Low heap memory detected!");
    }
    
    Serial.println();
}

/**
* @brief      Safe camera initialization with DMA overflow protection
*/
bool ei_camera_init_safe(void) {
    if (is_initialised) return true;
    
    Serial.println("Step 1: Configuring camera with DMA protection...");
    
    // Pre-configure GPIO pins to reduce initialization stress
    pinMode(PWDN_GPIO_NUM, OUTPUT);
    digitalWrite(PWDN_GPIO_NUM, LOW);  // Power up camera
    delay(100);
    
    Serial.println("Step 2: Starting camera initialization...");
    
    // Initialize camera with error handling
    esp_err_t err = esp_camera_init(&camera_config);
    if (err != ESP_OK) {
        Serial.printf("❌ Camera init failed with error: 0x%x\n", err);
        
        // Provide specific error meanings
        switch(err) {
            case ESP_ERR_INVALID_ARG:
                Serial.println("   → Invalid argument (wrong pin configuration)");
                break;
            case ESP_ERR_INVALID_STATE:
                Serial.println("   → Invalid state (camera already initialized?)");
                break;
            case ESP_ERR_NOT_FOUND:
                Serial.println("   → Camera not found (check connections)");
                break;
            case ESP_ERR_NO_MEM:
                Serial.println("   → Out of memory (DMA buffer allocation failed)");
                break;
            default:
                Serial.printf("   → Unknown error: 0x%x\n", err);
                break;
        }
        return false;
    }
    
    Serial.println("Step 3: Testing camera sensor...");
    
    // Get sensor and verify it's working
    sensor_t * s = esp_camera_sensor_get();
    if (s == nullptr) {
        Serial.println("❌ Cannot access camera sensor");
        esp_camera_deinit();
        return false;
    }
    
    Serial.printf("✅ Camera sensor detected: PID=0x%02X\n", s->id.PID);
    
    Serial.println("Step 4: Optimizing sensor settings for DMA...");
    
    // Conservative sensor settings to prevent DMA overflow
    s->set_brightness(s, 0);       // -2 to 2
    s->set_contrast(s, 0);         // -2 to 2  
    s->set_saturation(s, 0);       // -2 to 2
    s->set_special_effect(s, 0);   // 0 = No Effect
    s->set_whitebal(s, 1);         // Enable white balance
    s->set_awb_gain(s, 1);         // Enable AWB gain
    s->set_wb_mode(s, 0);          // Auto white balance
    s->set_exposure_ctrl(s, 1);    // Enable exposure control
    s->set_aec2(s, 0);             // Disable AEC2
    s->set_ae_level(s, 0);         // Auto exposure level
    s->set_aec_value(s, 300);      // Exposure value
    s->set_gain_ctrl(s, 1);        // Enable gain control
    s->set_agc_gain(s, 0);         // Auto gain
    s->set_gainceiling(s, (gainceiling_t)0); // Gain ceiling
    s->set_bpc(s, 0);              // Disable black pixel correction
    s->set_wpc(s, 1);              // Enable white pixel correction
    s->set_raw_gma(s, 1);          // Enable gamma correction
    s->set_lenc(s, 1);             // Enable lens correction
    s->set_hmirror(s, 0);          // Horizontal mirror
    s->set_vflip(s, 0);            // Vertical flip
    s->set_dcw(s, 1);              // Enable DCW (downsize)
    s->set_colorbar(s, 0);         // Disable color bar
    
    Serial.println("Step 5: Testing frame capture...");
    
    // Test capture with timeout
    camera_fb_t *fb = esp_camera_fb_get();
    if (!fb) {
        Serial.println("❌ Test capture failed");
        esp_camera_deinit();
        return false;
    }
    
    if (fb->len == 0) {
        Serial.println("❌ Empty frame captured");
        esp_camera_fb_return(fb);
        esp_camera_deinit();
        return false;
    }
    
    Serial.printf("✅ Test capture OK: %dx%d, %d bytes, fmt=%d\n", 
                 fb->width, fb->height, fb->len, fb->format);
    
    // Return frame buffer
    esp_camera_fb_return(fb);
    
    is_initialised = true;
    Serial.println("✅ Camera fully initialized with DMA protection");
    return true;
}

/**
* @brief      Main loop with DMA overflow monitoring
*/
void loop()
{
    static int loopCount = 0;
    loopCount++;
    
    Serial.printf("\n=== Inference Loop %d ===\n", loopCount);
    
    // Monitor memory and system health
    Serial.printf("Memory: Heap=%d", ESP.getFreeHeap());
    if (psramFound()) {
        Serial.printf(", PSRAM=%d", ESP.getFreePsram());
    }
    Serial.println();
    
    // Allocate snapshot buffer with overflow protection
    Serial.println("📸 Allocating camera buffer...");
    size_t buffer_size = EI_CAMERA_RAW_FRAME_BUFFER_COLS * EI_CAMERA_RAW_FRAME_BUFFER_ROWS * EI_CAMERA_FRAME_BYTE_SIZE;
    
    // Try PSRAM first, fall back to heap
    if (psramFound()) {
        snapshot_buf = (uint8_t*)ps_malloc(buffer_size);
        if (snapshot_buf) {
            Serial.println("✅ Using PSRAM for buffer");
        }
    } else {
        snapshot_buf = nullptr;
    }
    
    // Fall back to heap if PSRAM failed or unavailable
    if (snapshot_buf == nullptr) {
        snapshot_buf = (uint8_t*)malloc(buffer_size);
        if (snapshot_buf) {
            Serial.println("✅ Using heap for buffer");
        } else {
            Serial.println("❌ Buffer allocation failed!");
            delay(5000);
            return;
        }
    }
    
    // Setup signal for Edge Impulse
    ei::signal_t signal;
    signal.total_length = EI_CLASSIFIER_INPUT_WIDTH * EI_CLASSIFIER_INPUT_HEIGHT;
    signal.get_data = &ei_camera_get_data;

    // Capture image with DMA overflow protection
    Serial.println("📷 Capturing image...");
    if (!ei_camera_capture((size_t)EI_CLASSIFIER_INPUT_WIDTH, (size_t)EI_CLASSIFIER_INPUT_HEIGHT, snapshot_buf)) {
        Serial.println("❌ Image capture failed");
        free(snapshot_buf);
        delay(3000);
        return;
    }
    
    Serial.println("✅ Image captured successfully");

    // Run Edge Impulse inference
    Serial.println("🧠 Running inference...");
    ei_impulse_result_t result = { 0 };

    EI_IMPULSE_ERROR err = run_classifier(&signal, &result, debug_nn);
    if (err != EI_IMPULSE_OK) {
        Serial.printf("❌ Inference failed: %d\n", err);
        free(snapshot_buf);
        delay(3000);
        return;
    }
    
    Serial.println("✅ Inference completed");

    // Print timing information
    Serial.printf("⏱️  Timing - DSP: %d ms, Classification: %d ms, Anomaly: %d ms\n",
                result.timing.dsp, result.timing.classification, result.timing.anomaly);

    // Process results
#if EI_CLASSIFIER_OBJECT_DETECTION == 1
    Serial.printf("🔍 Object detections: %d\n", result.bounding_boxes_count);
    
    for (uint32_t i = 0; i < result.bounding_boxes_count; i++) {
        ei_impulse_result_bounding_box_t bb = result.bounding_boxes[i];
        if (bb.value == 0) continue;
        
        Serial.printf("  [%d] %s: %.3f [x:%u y:%u w:%u h:%u]", 
                i, bb.label, bb.value, bb.x, bb.y, bb.width, bb.height);
        
        // Check for trash detection
        if (bb.value > TRASH_CONFIDENCE_THRESHOLD && 
            (strstr(bb.label, "trash") != NULL || 
             strstr(bb.label, "bottle") != NULL || 
             strstr(bb.label, "can") != NULL ||
             strstr(bb.label, "garbage") != NULL ||
             strstr(bb.label, "waste") != NULL)) {
            Serial.print(" → 🗑️ TRASH DETECTED!");
        }
        Serial.println();
    }
    
#else
    Serial.println("📊 Classification results:");
    for (uint16_t i = 0; i < EI_CLASSIFIER_LABEL_COUNT; i++) {
        Serial.printf("  %s: %.5f", ei_classifier_inferencing_categories[i], result.classification[i].value);
        
        if (result.classification[i].value > TRASH_CONFIDENCE_THRESHOLD &&
            (strstr(ei_classifier_inferencing_categories[i], "trash") != NULL || 
             strstr(ei_classifier_inferencing_categories[i], "bottle") != NULL ||
             strstr(ei_classifier_inferencing_categories[i], "garbage") != NULL)) {
            Serial.print(" → 🗑️ TRASH DETECTED!");
        }
        Serial.println();
    }
#endif

    // Clean up memory
    free(snapshot_buf);
    Serial.println("✅ Loop completed successfully");
    
    delay(4000);  // Wait before next inference
}

/**
 * @brief      Stop camera
 */
void ei_camera_deinit(void) {
    esp_err_t err = esp_camera_deinit();
    if (err != ESP_OK) {
        Serial.printf("Camera deinit failed: 0x%x\n", err);
        return;
    }
    is_initialised = false;
}

/**
 * @brief      Capture and process image with DMA protection
 */
bool ei_camera_capture(uint32_t img_width, uint32_t img_height, uint8_t *out_buf) {
    if (!is_initialised) {
        Serial.println("❌ Camera not initialized");
        return false;
    }

    // Capture frame with DMA overflow protection
    camera_fb_t *fb = esp_camera_fb_get();
    if (!fb) {
        Serial.println("❌ Camera capture failed - DMA overflow possible");
        return false;
    }

    if (fb->len == 0) {
        Serial.println("❌ Empty frame - DMA issue");
        esp_camera_fb_return(fb);
        return false;
    }

    // Successful capture
    Serial.printf("Frame: %dx%d, %d bytes, fmt=%d\n", 
                 fb->width, fb->height, fb->len, fb->format);

    // Convert JPEG to RGB888
    bool converted = fmt2rgb888(fb->buf, fb->len, PIXFORMAT_JPEG, out_buf);
    esp_camera_fb_return(fb);

    if(!converted){
        Serial.println("❌ Format conversion failed");
        return false;
    }

    // Resize if needed
    if ((img_width != EI_CAMERA_RAW_FRAME_BUFFER_COLS) || (img_height != EI_CAMERA_RAW_FRAME_BUFFER_ROWS)) {
        ei::image::processing::crop_and_interpolate_rgb888(
            out_buf,
            EI_CAMERA_RAW_FRAME_BUFFER_COLS,
            EI_CAMERA_RAW_FRAME_BUFFER_ROWS,
            out_buf,
            img_width,
            img_height);
    }

    return true;
}

/**
 * @brief      Get image data for classifier
 */
static int ei_camera_get_data(size_t offset, size_t length, float *out_ptr)
{
    size_t pixel_ix = offset * 3;
    size_t pixels_left = length;
    size_t out_ptr_ix = 0;

    while (pixels_left != 0) {
        // BGR to RGB conversion for ESP32 camera
        out_ptr[out_ptr_ix] = (snapshot_buf[pixel_ix + 2] << 16) + 
                              (snapshot_buf[pixel_ix + 1] << 8) + 
                              snapshot_buf[pixel_ix];
        out_ptr_ix++;
        pixel_ix += 3;
        pixels_left--;
    }
    return 0;
}

